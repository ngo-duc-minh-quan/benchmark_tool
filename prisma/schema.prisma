generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BenchmarkResult {
  id                        String   @id @default(cuid())
  clientResultId            String?  @unique
  deviceName                String
  os                        String
  browser                   String
  cpuCores                  Int
  ramGB                     Float
  gpuRenderer               String
  avgFPS                    Float
  minFPS                    Float
  onePercentLow             Float
  cpuScore                  Float?
  gpuScore                  Float?
  singleCoreWorkUnitsPerSec Float?
  multiCoreWorkUnitsPerSec  Float?
  cpuCoresUsed              Int?
  score                     Float
  tier                      String
  batteryDrain              Float
  fpsTimeline               String
  createdAt                 DateTime @default(now())
}
